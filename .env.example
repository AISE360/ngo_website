# ── Supabase (public, safe for browser) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# fallback alias:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Razorpay (public key only — secret stays in Edge Function secrets) ──
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ── Optional ──
VITE_WHATSAPP_NUMBER=919876543210
VITE_SITE_URL=http://localhost:5173

# ── Edge Function secrets (set via `supabase secrets set`, NEVER in frontend) ──
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_SECRET=xxxxxxxx
# WA_PHONE_ID=xxxxxxxx
# WA_ACCESS_TOKEN=xxxxxxxx
# ADMIN_WHATSAPP=919876543210
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key (verify fn only)
